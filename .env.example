# Runtime
APP_ENV=development
DATABASE_PATH=backend/data/support.db
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_API_KEY=change-me-before-deploying

# AI provider: local (zero-cost demo) or openai (production-quality generation)
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Accuracy controls
TOP_K=4
MIN_RETRIEVAL_SCORE=0.12
MAX_CONTEXT_CHARS=12000

# Frontend (used by Vite at build time)
VITE_API_URL=http://localhost:8000

